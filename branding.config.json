{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "_doc": "Aura branding replacement config. Used by web/scripts/apply-aura-branding.ts. Edit here, not in the script.",
  "replacements": [
    { "from": "Vibe-Companion", "to": "Aura Companion" },
    { "from": "Vibe Companion", "to": "Aura Companion" },
    { "from": "The Companion", "to": "Aura Companion" },
    { "from": "the-companion", "to": "aura-companion", "contexts": ["**/*.json", "**/*.md", "**/*.mdx", "**/*.ts", "**/*.tsx", "**/*.html", "**/*.yml", "**/*.yaml"] }
  ],
  "protectedPaths": [
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.cache/**",
    ".git/**",
    "*.lockb",
    "*.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    ".env",
    ".env.*",
    "**/*.jsonl",
    ".agents/knowledge/**",
    "web/server/protocol/**",
    "web/server/recorder.ts",
    "web/server/recorder.test.ts",
    "web/server/replay.ts",
    "web/server/replay.test.ts",
    "CHANGELOG.md",
    "web/CHANGELOG.md",
    "release-please-config.json",
    ".release-please-manifest.json",
    "branding.config.json",
    "PLAN-upstream-sync.md",
    "specs/upstream-sync.md",
    "**/__fixtures__/**",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/coverage/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.ico",
    "**/*.webp",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.eot",
    "**/*.mp3",
    "**/*.mp4",
    "**/*.wav",
    "bun.log",
    "**/bun.log",
    ".restart-server.sh"
  ],
  "_keepUpstreamMarker_doc": "Add this comment on the line PRECEDING any line that legitimately references upstream (e.g. update-checker.ts querying the-companion npm package). The replacer will skip the next line.",
  "keepUpstreamMarker": "aura-keep-upstream-name",
  "_visualAssets_doc": "Manual checklist surfaces — the script will warn if these files contain unbranded strings, but won't auto-rewrite (binary or structurally-significant).",
  "visualAssetChecklist": [
    "web/public/manifest.json",
    "web/public/manifest.webmanifest",
    "web/index.html",
    "web/public/favicon.svg",
    "web/public/icon-192.png",
    "web/public/icon-512.png",
    "web/public/apple-touch-icon.png",
    "web/public/og-image.png"
  ]
}
