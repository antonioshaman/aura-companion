# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── Server (bun runtime, read by web/server/*) ──────────────────────────────
# Origin allowlist for WebSocket upgrade (/ws/browser, /ws/terminal, /ws/novnc).
# Comma-separated list of full origins (scheme + host + port, no trailing slash).
# Dev frontends on http://localhost:5173 / :5174 and same-host requests with
# no Origin header are accepted unconditionally. Anything else must appear
# here or the WS upgrade is rejected and the UI surfaces "Connection timeout".
# Required for any production deploy reached over a non-loopback origin
# (public IP, LAN host, tailscale hostname, reverse-proxy public domain).
# Example: COMPANION_ALLOWED_ORIGIN=http://65.108.82.189:3456,https://companion.example.com
COMPANION_ALLOWED_ORIGIN=
