# ---------------------------------------------------------------------------
# Gonka proxy secrets. Copy to a real env file with MODE 600, owned by the
# service user. NEVER commit the filled-in version. NEVER bake into an image.
#
#   cp .env.example shim.env      # -> holds GONKA_* + SHIM_API_KEY + GONKA_MODEL
#   cp .env.example litellm.env   # -> holds LITELLM_MASTER_KEY + SHIM_API_KEY
#   chmod 600 shim.env litellm.env
# ---------------------------------------------------------------------------

# --- Signing shim (shim.env) ---
# ECDSA private key of your Gonka account. THE ONLY real secret of the network.
# Stays in the shim's env; never enters Aura.
GONKA_PRIVATE_KEY=0xREPLACE_ME

# Provide ONE of the following endpoint sources:
# (a) discovery URL — the shim resolves + selects a network endpoint from it:
GONKA_SOURCE_URL=https://REPLACE_ME.gonka.example/
# (b) OR explicit endpoints, comma-separated "url;gonkaAddress" pairs:
# GONKA_ENDPOINTS=https://node1.example;gonka1abc...,https://node2.example;gonka1def...

# Optional: enable ICS23 proof verification during endpoint discovery.
# GONKA_VERIFY_PROOF=1
# Optional: override the derived gonka address.
# GONKA_ADDRESS=gonka1...

# Model the shim serves by default (also advertised on /v1/models).
GONKA_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8

# Shim bind + shared secret (LiteLLM presents this as a bearer token).
SHIM_HOST=127.0.0.1
SHIM_PORT=8080
SHIM_API_KEY=REPLACE_WITH_RANDOM_STRING

# --- LiteLLM (litellm.env) ---
# The single secret Aura stores (as ANTHROPIC_AUTH_TOKEN). Keep the sk- prefix.
LITELLM_MASTER_KEY=sk-CHANGEME
# Same value as above so LiteLLM can authenticate to the shim.
SHIM_API_KEY=REPLACE_WITH_RANDOM_STRING
