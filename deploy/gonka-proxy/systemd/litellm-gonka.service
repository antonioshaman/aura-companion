# /etc/systemd/system/litellm-gonka.service
# LiteLLM Anthropic<->OpenAI translator in front of the Gonka shim.
# SEPARATE from aura-companion.service — do NOT add KillMode=process here.
# Depends on the shim being up first.

[Unit]
Description=LiteLLM (Anthropic<->OpenAI) for Gonka
After=network-online.target gonka-shim.service
Wants=network-online.target
Requires=gonka-shim.service

[Service]
Type=simple
User=gonka-proxy
Group=gonka-proxy
WorkingDirectory=/opt/gonka-proxy
EnvironmentFile=/etc/gonka-proxy/litellm.env
# Assumes litellm installed in the same venv (pip install 'litellm[proxy]'==<pin>).
ExecStart=/opt/gonka-proxy/venv/bin/litellm --config /opt/gonka-proxy/litellm/config.yaml --host 127.0.0.1 --port 4000
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
