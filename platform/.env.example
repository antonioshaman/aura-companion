# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Standard Postgres connection string. Works with Railway Postgres, Neon, Supabase, etc.
DATABASE_URL=postgresql://user:password@host:5432/companion?sslmode=require

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-session-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3458

# ─── Resend (transactional emails) ───────────────────────────────────────────
# When set, enables email verification on sign-up, password reset emails,
# and organization invitation emails via Resend.
# Without it, emails are logged to console (dev mode) and verification is skipped.
RESEND_API_KEY=re_...
# Optional — defaults to "Companion Cloud <noreply@thecompanion.sh>"
RESEND_FROM_EMAIL=Companion Cloud <noreply@thecompanion.sh>

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── Instance provisioning ──────────────────────────────────────────────────
# Managed-runtime server image that starts `aura-companion serve`. The fork
# publishes no such image — set this to your own registry path before using
# the managed-runtime provisioning flow (not needed for the VPS git-pull deploy).
COMPANION_IMAGE=

# ─── Hetzner Cloud (instance provisioning) ──────────────────────────────────
# Required
HETZNER_API_TOKEN=hcloud_...
# Optional Hetzner SSH key id/name to inject during server create
HETZNER_SSH_KEY_ID=
# Optional per-plan server type overrides
HETZNER_SERVER_TYPE_STARTER=cpx11
HETZNER_SERVER_TYPE_PRO=cpx21
HETZNER_SERVER_TYPE_ENTERPRISE=cpx31

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3458

# ─── Instance bootstrap (secrets delivery) ──────────────────────────────────
# Public https origin of this control plane. New instances call
# <origin>/api/instance-bootstrap once with a one-time token from cloud-init to
# fetch their auth token, so long-lived secrets never sit in user_data.
# If unset, derived from X-Forwarded-Host/Proto of the create request.
COMPANION_CLOUD_PUBLIC_URL=https://cloud.example.com
# One-time bootstrap token lifetime (ms). Default 30 min.
PLATFORM_BOOTSTRAP_TOKEN_TTL_MS=1800000

# ─── Orphan reconciler ──────────────────────────────────────────────────────
# Deletes Hetzner servers/volumes labelled app=companion + organization that no
# DB row claims. Runs only when HETZNER_API_TOKEN and DATABASE_URL are set.
# Interval (ms, 0 = disabled; default 15 min) and grace period (ms; resources
# and "provisioning" rows younger than this are never touched; default 30 min,
# minimum 5 min). Set DRY_RUN=1 to only log what would be deleted.
PLATFORM_RECONCILER_INTERVAL_MS=900000
PLATFORM_RECONCILER_GRACE_MS=1800000
PLATFORM_RECONCILER_DRY_RUN=1
